# Every value is optional. With none of them, `npm run demo` runs the whole batch
# offline and `npm run live` reports each integration as NOT SET instead of failing.
# Copy to .env and fill in only what you have. .env is gitignored.

# ── Stripe (TEST MODE ONLY — sk_live_ keys are refused before any request) ──
# dashboard.stripe.com -> toggle "Test mode" -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=

# ── Email via Resend ──
# resend.com -> API Keys. The free tier only delivers to your own account address
# until you verify a domain. The demo refuses to email anyone except DEMO_EMAIL.
RESEND_API_KEY=
DEMO_EMAIL=
EMAIL_FROM=Recovery Agent <onboarding@resend.dev>

# ── AI voice calls via CALL-E ──
# The demo dials ONLY numbers on CALLE_ALLOWED_NUMBERS (E.164, comma-separated).
# Put your own phone here. Defaults to DEMO_PHONE when unset.
CALLE_API_KEY=
DEMO_PHONE=
CALLE_ALLOWED_NUMBERS=
# What one call costs you, in cents. The channel decision depends on it.
CALL_COST_CENTS=150

# ── Slack incoming webhook (notification only) ──
# api.slack.com/apps -> your app -> Incoming Webhooks -> Add New Webhook
SLACK_WEBHOOK_URL=

# ── Cosmetic ──
MERCHANT_NAME=Acme Cloud
